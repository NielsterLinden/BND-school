Sample: "Fakes_mm"
  Group: "Fakes"
  Title: "Fakes_mm"
  FillColor: 799
  LineColor: 799
  NtuplePathSuff: "fakes_charge/mm_plv_mm_v4/"
  NtupleFiles: "mm_dataOS*"
  MCweight: "MMweight"
  Selection: "nBJets77>=1 && lep0_charge<0"
  NormalizedByTheory: FALSE

% -------------------- %
% --- NORM FACTORS --- %
% -------------------- %

NormFactor: "mu_ttW_EW"
  Samples: ttW_EW
  Title: "#mu_{t#bar{t}W EW}"
  Nominal: 1.0
  Min: -10.0 
  Max: 10.0

NormFactor: "norm_ttW_QCD"
  Samples: ttW_QCD
  Title: "N_{t#bar{t}W QCD}"
  Nominal: 1.0
  Min: -10.0
  Max: 10.0

NormFactor: "norm_ttZ"
  Samples: ttZ
  Title: "N_{t#bar{t}Z}"
  Nominal: 1.0
  Min: -10.0
  Max: 10.0

NormFactor: "norm_diboson"
  Samples: diboson
  Title: "N_{VV}"
  Nominal: 1.0
  Min: -10.0
  Max: 10.0

