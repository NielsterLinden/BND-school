% --------------- %
% ---  JOB    --- %
% --------------- %

Job: "EFTRExFitter_Tutorial_SM_Fit"
  OutputDir: "test/inputs/EFT/"
  Label: "tW scattering"
  CmeLabel: "13 TeV"
  POI:"mu_ttW_EW" 
  ReadFrom: NTUP
  NtuplePaths: /mnt/lustre/scratch/epp/tjs31/ttwj/ttwj_160123/
  LumiLabel: "140 fb^{-1}"
  Lumi: 140068.94
  MCweight: "1."
  PlotOptions: "NOXERR,YIELDS" 
  NtupleName: "nominal_Loose"
  DebugLevel: 1
  MCstatThreshold: 0.01
  SystControlPlots: FALSE
  UseATLASRounding: TRUE
  RankingMaxNP: 15
  HistoChecks: NOCRASH
  SplitHistoFiles: TRUE   % set this in order to have separated .root files in Histograms/ for different regions
  ImageFormat: "png"
  SystCategoryTables: TRUE
  CorrelationThreshold: 0.1
  StatOnly: FALSE 
  SystPruningShape: 0.001 
  SystPruningNorm: 0.001 
  SystLarge: 0.5
  RemoveLargeSyst: TRUE

% --------------- %
% ---  FIT    --- %
% --------------- %

Fit: "fit"
  FitType: SPLUSB
  FitRegion: CRSR
  FitBlind: FALSE
  POIAsimov: 1.0
  UseMinos: "mu_ttW_EW","norm_ttW_QCD","norm_ttZ","norm_diboson"
  SetRandomInitialNPval: 0.1
  SetRandomInitialNPvalSeed: 1234567

% --------------- %
% ---  LIMIT  --- %
% --------------- %

Limit: "limit"
  LimitType: ASYMPTOTIC
  LimitBlind: TRUE %FALSE %TRUE - stick to pre-fit predictions for the background.
  SignalInjection: FALSE %TRUE
  SignalInjectionValue: 1.0

%%%%%%%%%%%%%%%%%%%%%%%
% Significance
%%%%%%%%%%%%%%%%%%%%%%%

Significance:"significance"
  SignificanceBlind: FALSE
  POIAsimov: 1.0

% --------------- %
% --- REGIONS --- %
% --------------- %

Region: "sr_deltaEta"
  Type: SIGNAL 
  DataType: ASIMOV
  Variable: "delta_eta_j",9,2,10
  Binning: 2,3,6,10
  VariableTitle: "#Delta #eta_{j}"
  Label: "SR "
  ShortLabel: "SR "
  Selection: "pass_sr_deltaEta"

Region:"CR2lss4j"
  Type: CONTROL
  DataType: DATA
  Variable: "channel",12,-3,9
  BinLabels: "1b-e^{-}e^{-}","1b-e^{-}#mu^{-}","1b-#mu^{-}#mu^{-}","1b-#mu^{+}#mu^{+}","1b-e^{+}#mu^{+}","1b-e^{+}e^{+}","2b-e^{-}e^{-}","2b-e^{-}#mu^{-}","2b-#mu^{-}#mu^{-}","2b-#mu^{+}#mu^{+}","2b-e^{+}#mu^{+}","2b-e^{+}e^{+}"
  VariableTitle: "Channels"
  Label: "CR-2lss-4j"
  ShortLabel: "4J-lo#Delta#eta-CR"
  Selection: "pass_CR2lss4j"

Region: "CR2lss3j"
  Type: CONTROL
  DataType: DATA
  Variable: "channel",12,-3,9
  BinLabels: "1b-e^{-}e^{-}","1b-e^{-}#mu^{-}","1b-#mu^{-}#mu^{-}","1b-#mu^{+}#mu^{+}","1b-e^{+}#mu^{+}","1b-e^{+}e^{+}","2b-e^{-}e^{-}","2b-e^{-}#mu^{-}","2b-#mu^{-}#mu^{-}","2b-#mu^{+}#mu^{+}","2b-e^{+}#mu^{+}","2b-e^{+}e^{+}"
  VariableTitle: "Channels"
  Label: "CR-2lss-3j"
  ShortLabel: "CR-2lss-3j"
  Selection: "pass_CR2lss3j"

Region: "CR3lttZ"
  Type: CONTROL
  DataType: DATA
  Variable: "ht",4,0,2000
  Binning: 0,400,800,1200,2000
  VariableTitle: "H_{T}"
  Label: "CR-3l-ttZ"
  ShortLabel: "CR-3l-ttZ"
  Selection: "pass_CR3lttZ"

Region: "CR3lVV"
  Type: CONTROL
  DataType: DATA
  Variable: "ht",4,0,2000
  Binning: 0,360,730,1100,2000
  VariableTitle: "H_{T}"
  Label: "CR-3l-VV"
  ShortLabel: "CR-3l-VV"
  Selection: "pass_CR3lVV"

% --------------- %
% --- SAMPLES --- %
% --------------- %

Sample: "ttW_EW"
  Type: SIGNAL 
  Title: "t#bar{t}W EW"
  FillColor: 0
  LineColor: 1
  NtupleFiles: "700205d","700205a","700205e"
  MCweight: "weight_nominal"

