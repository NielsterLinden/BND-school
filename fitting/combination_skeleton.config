% Combination of the three Z -> ll channels: TRExFitter v1.8.0 MultiFit over the individual
% workspaces. Run from combination/ after every channel has produced its workspace (`hw`):
%     trex-fitter mwf comb.config      trex-fitter mdp comb.config
%     trex-fitter mr  comb.config      trex-fitter mi  comb.config
% Stat-only: every channel and this file with  "StatOnly=TRUE:Suffix=_statOnly".
MultiFit: "comb"
  Label: "Z #rightarrow ll combination"
  OutputDir: "results"
  Combine: TRUE
  Compare: TRUE
  ComparePOI: TRUE
  ComparePulls: TRUE
  PlotCombCorrMatrix: TRUE
  POIName: "mu_Z"
  POIRange: 0.9:1.1
  DataName: "obsData"
  CmeLabel: "13 TeV"
  LumiLabel: "16.4 fb^{-1}"
  NumCPU: 4

Fit: "zmumu"
  ConfigFile: ../z-mumu/fit/zmumu.config
  Directory: ../z-mumu/fit/results/zmumu
  Label: "#mu#mu"

Fit: "zee"
  ConfigFile: ../z-ee/fit/zee.config
  Directory: ../z-ee/fit/results/zee
  Label: "ee"

Fit: "ztautau"
  ConfigFile: ../z-tautau/fit/ztautau.config
  Directory: ../z-tautau/fit/results/ztautau
  Label: "#tau#tau"
