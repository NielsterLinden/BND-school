% Z -> tau_h tau_h, generated by z-tautau/scripts/step5_fit.py (do not edit by hand); tau_h working point Medium
% fake-factor variant: nosub; fit variable m_tt in 3 BDT categories; TRExFitter v1.8.0

Job: "ztautau_nosub"
  Label: "Z #rightarrow #tau_{h}#tau_{h}"
  CmeLabel: "13 TeV"
  LumiLabel: "16.4 fb^{-1}"
  ExperimentLabel: "CMS"
  PlotLabel: "Open Data"
  POI: "mu_Z"
  ReadFrom: HIST
  HistoPath: "fitinputs"
  HistoFile: "ztautau_nosub"
  OutputDir: "results"
  MCstatThreshold: 0.0
  UseGammaPulls: TRUE
  DebugLevel: 1
  ImageFormat: "png"
  SystControlPlots: TRUE
  DoSummaryPlot: TRUE
  DoTables: TRUE
  DoSignalRegionsPlot: FALSE
  DoPieChartPlot: TRUE
  RankingMaxNP: 20
  RankingPlot: SYSTS
  HistoChecks: "NOCRASH"
  SystPruningShape: 0.001
  SystPruningNorm: 0.001
  GetChi2: TRUE
  SystCategoryTables: TRUE
  RatioYmax: 1.5
  RatioYmin: 0.5
  POIPrecision: 3
  SummaryPlotYmin: 1
  LegendNColumns: 2

Fit: "fit"
  FitType: SPLUSB
  FitRegion: CRSR
  UseMinos: "mu_Z"
  NumCPU: 4

Region: "tautau_SR0"
  Type: SIGNAL
  HistoName: "tautau_SR0"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "BDT < 0.55 (fake dominated)"
  ShortLabel: "SR0"
  DropBins: 1,2,3,4,5,6,7

Region: "tautau_SR1"
  Type: SIGNAL
  HistoName: "tautau_SR1"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "0.55 < BDT < 0.90"
  ShortLabel: "SR1"

Region: "tautau_SR2"
  Type: SIGNAL
  HistoName: "tautau_SR2"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "BDT > 0.90 (signal dominated)"
  ShortLabel: "SR2"

Sample: "Data"
  Type: DATA
  Title: "Data"
  HistoNameSuff: "__Data"

Sample: "DYtautau"
  Type: SIGNAL
  Title: "Z#rightarrow#tau#tau (fiducial)"
  HistoNameSuff: "__DYtautau"
  FillColor: 796
  LineColor: 1
  UseMCstat: TRUE

Sample: "DYtautau_nonfid"
  Type: BACKGROUND
  Title: "Z/#gamma*#rightarrow#tau#tau (non-fid.)"
  HistoNameSuff: "__DYtautau_nonfid"
  FillColor: 800
  LineColor: 1
  UseMCstat: TRUE

Sample: "DYee"
  Type: BACKGROUND
  Title: "Z#rightarrowee"
  HistoNameSuff: "__DYee"
  FillColor: 857
  LineColor: 1
  UseMCstat: TRUE

Sample: "DYmumu"
  Type: BACKGROUND
  Title: "Z#rightarrow#mu#mu"
  HistoNameSuff: "__DYmumu"
  FillColor: 862
  LineColor: 1
  UseMCstat: TRUE

Sample: "DYlowmass"
  Type: BACKGROUND
  Title: "Z/#gamma*#rightarrowll (m<50)"
  HistoNameSuff: "__DYlowmass"
  FillColor: 795
  LineColor: 1
  UseMCstat: TRUE

Sample: "WJets"
  Type: BACKGROUND
  Title: "W+jets"
  HistoNameSuff: "__WJets"
  FillColor: 632
  LineColor: 1
  UseMCstat: FALSE

Sample: "TTbar"
  Type: BACKGROUND
  Title: "t#bar{t}"
  HistoNameSuff: "__TTbar"
  FillColor: 616
  LineColor: 1
  UseMCstat: TRUE

Sample: "SingleTop"
  Type: BACKGROUND
  Title: "single t"
  HistoNameSuff: "__SingleTop"
  FillColor: 617
  LineColor: 1
  UseMCstat: TRUE

Sample: "WW"
  Type: BACKGROUND
  Title: "WW"
  HistoNameSuff: "__WW"
  FillColor: 418
  LineColor: 1
  UseMCstat: TRUE

Sample: "WZ"
  Type: BACKGROUND
  Title: "WZ"
  HistoNameSuff: "__WZ"
  FillColor: 419
  LineColor: 1
  UseMCstat: TRUE

Sample: "ZZ"
  Type: BACKGROUND
  Title: "ZZ"
  HistoNameSuff: "__ZZ"
  FillColor: 420
  LineColor: 1
  UseMCstat: TRUE

Sample: "Fakes"
  Type: BACKGROUND
  Title: "jet#rightarrow#tau_{h} (FF)"
  HistoNameSuff: "__Fakes"
  FillColor: 606
  LineColor: 1
  UseMCstat: TRUE

NormFactor: "mu_Z"
  Title: "#mu_{Z}"
  Nominal: 1
  Min: 0
  Max: 3
  Samples: "DYtautau"

Systematic: "Lumi"
  Title: "Luminosity"
  Type: OVERALL
  OverallUp: 0.012
  OverallDown: -0.012
  Samples: DYtautau,DYtautau_nonfid,DYee,DYmumu,DYlowmass,WJets,TTbar,SingleTop,WW,WZ,ZZ
  Category: "Luminosity"

Systematic: "XS_DYll"
  Title: "#sigma(Z#rightarrowee/#mu#mu)"
  Type: OVERALL
  OverallUp: 0.05
  OverallDown: -0.05
  Samples: DYee,DYmumu
  Category: "Background normalisation"

Systematic: "XS_DYtautau_nonfid"
  Title: "#sigma(Z/#gamma*#rightarrow#tau#tau (non-fid.))"
  Type: OVERALL
  OverallUp: 0.05
  OverallDown: -0.05
  Samples: "DYtautau_nonfid"
  Category: "Background normalisation"

Systematic: "XS_DYlowmass"
  Title: "#sigma(Z/#gamma*#rightarrowll (m<50))"
  Type: OVERALL
  OverallUp: 0.1
  OverallDown: -0.1
  Samples: "DYlowmass"
  Category: "Background normalisation"

