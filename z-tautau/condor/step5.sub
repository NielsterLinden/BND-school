# CH (this z-tautau checkout) and params (the file with one job per line) come from condor/orchestrator.sh:
#   condor_submit CH=<checkout>/z-tautau params=<file> condor/step5.sub
executable = $(CH)/condor/run_step5.sh
arguments  = $(CH) $(args)

output = $(CH)/condor/out/step5_$(Cluster).$(Process).log
error  = $(CH)/condor/err/step5_$(Cluster).$(Process).log
log    = $(CH)/condor/logs/step5_$(Cluster).log

stream_output = True
stream_error  = True

accounting_group = atlas

request_cpus   = 4
request_memory = 6GB

+JobCategory = "short"
+SingularityImage    = "/cvmfs/atlas.cern.ch/repo/containers/fs/singularity/x86_64-almalinux9"
+SingularityBindCVMFS = True

JobBatchName = "ztt_fit"

queue args from $(params)
