Sample: "ZZ_tDMnone"
  Type: BACKGROUND
  Title: "ZZ [none]"
  Group: "ZZ"
  HistoNameSuff: "__ZZ_tDMnone"
  FillColor: 420
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "Fakes"
  Type: BACKGROUND
  Title: "jet#rightarrow#tau_{h} / multijet"
  Group: "jet#rightarrow#tau_{h} / multijet"
  HistoNameSuff: "__Fakes"
  FillColor: 606
  LineColor: 1

NormFactor: "mu_Z"
  Title: "#mu_{Z}"
  Nominal: 1
  Min: 0
  Max: 3
  Samples: "DYtautau_tDMnone"

NormFactor: "mu_ttbar"
  Title: "#mu_{t#bar{t}}"
  Nominal: 1
  Min: 0
  Max: 3
  Samples: "TTbar_tDMnone"

Systematic: "BTag"
  Title: "b-tag efficiency"
  Type: HISTO
  HistoNameSufUp: "__BTagUp"
  HistoNameSufDown: "__BTagDown"
  Samples: DYee_tDMnone,DYmumu_tDMnone,DYtautau_out_tDMnone,DYtautau_tDMnone,DYlowmass_tDMnone,WJets_tDMnone,TTbar_tDMnone,SingleTop_tDMnone,WW_tDMnone,WZ_tDMnone,ZZ_tDMnone
