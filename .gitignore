# fit inputs and outputs (regenerated by each channel's fit scripts)
*/fit/fitinputs/
*/fit/results/
combination/fit/results/

# presentation (Manim): render scratch stays out of git; the delivered MP4s in
# clips/ are committed with scenes / style / tools / data json / docs
presentation/work/
presentation/media/
presentation/**/*.png
!presentation/figures/*.png

# Claude Code: session-local state (the shared guide, agents and prompts in .claude/ are committed)
.claude/worktrees/
.claude/settings.local.json

.asetup.save
