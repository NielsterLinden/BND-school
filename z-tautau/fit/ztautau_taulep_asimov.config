% Z -> tautau v4 (four channels), generated by z-tautau/scripts/step5_fit.py (do not edit by hand); tau_h working point Tight
% tau_h ID scale factors free per decay mode (nominal = TauPOG), tau energy scale prior 3%; TRExFitter v1.8.0

Job: "ztautau_taulep"
  Label: "Z #rightarrow #tau#tau (#tau_{h}#tau_{h}, #mu#tau_{h}, e#tau_{h}, e#mu)"
  CmeLabel: "13 TeV"
  LumiLabel: "16.4 fb^{-1}"
  ExperimentLabel: "CMS"
  PlotLabel: "Open Data"
  POI: "mu_Z"
  ReadFrom: HIST
  HistoPath: "fitinputs"
  HistoFile: "ztautau"
  OutputDir: "results"
  MCstatThreshold: 0.0
  UseGammaPulls: TRUE
  DebugLevel: 1
  ImageFormat: "png"
  SystControlPlots: FALSE
  DoSummaryPlot: TRUE
  DoTables: TRUE
  DoSignalRegionsPlot: FALSE
  DoPieChartPlot: TRUE
  RankingMaxNP: 25
  RankingPlot: SYSTS
  HistoChecks: NOCRASH
  SystPruningShape: 0.001
  SystPruningNorm: 0.001
  GetChi2: TRUE
  SystCategoryTables: TRUE
  RatioYmax: 1.5
  RatioYmin: 0.5
  POIPrecision: 3
  SummaryPlotYmin: 1
  LegendNColumns: 2
  PlotOptions: NOSIG,NOXERR
  SummaryPlotRegions: tautau_SR0,tautau_SR1,tautau_SR2,mutau_SR_dm0,mutau_SR_dm1,mutau_SR_dm10,mutau_SR_dm11,etau_SR_dm0,etau_SR_dm1,etau_SR_dm10,etau_SR_dm11

Fit: "fit"
  FitType: SPLUSB
  FitRegion: CRSR
  UseMinos: "mu_Z"
  NumCPU: 6
  FitStrategy: 2

Region: "tautau_SR0"
  Type: SIGNAL
  HistoName: "tautau_SR0"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "#tau_{h}#tau_{h}, BDT < 0.55"
  ShortLabel: "tautau_SR0"
  DropBins: 1,2,3,4,5,6,7

Region: "tautau_SR1"
  Type: SIGNAL
  HistoName: "tautau_SR1"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "#tau_{h}#tau_{h}, 0.55 < BDT < 0.90"
  ShortLabel: "tautau_SR1"

Region: "tautau_SR2"
  Type: SIGNAL
  HistoName: "tautau_SR2"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "#tau_{h}#tau_{h}, BDT > 0.90"
  ShortLabel: "tautau_SR2"

Region: "mutau_SR_dm0"
  Type: SIGNAL
  HistoName: "mutau_SR_dm0"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "#mu#tau_{h}, DM 0"
  ShortLabel: "mutau_SR_dm0"

Region: "mutau_SR_dm1"
  Type: SIGNAL
  HistoName: "mutau_SR_dm1"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "#mu#tau_{h}, DM 1"
  ShortLabel: "mutau_SR_dm1"

Region: "mutau_SR_dm10"
  Type: SIGNAL
  HistoName: "mutau_SR_dm10"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "#mu#tau_{h}, DM 10"
  ShortLabel: "mutau_SR_dm10"

Region: "mutau_SR_dm11"
  Type: SIGNAL
  HistoName: "mutau_SR_dm11"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "#mu#tau_{h}, DM 11"
  ShortLabel: "mutau_SR_dm11"

Region: "etau_SR_dm0"
  Type: SIGNAL
  HistoName: "etau_SR_dm0"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "e#tau_{h}, DM 0"
  ShortLabel: "etau_SR_dm0"

Region: "etau_SR_dm1"
  Type: SIGNAL
  HistoName: "etau_SR_dm1"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "e#tau_{h}, DM 1"
  ShortLabel: "etau_SR_dm1"

Region: "etau_SR_dm10"
