Job: "FitExampleTemplate_2D"
  Label: "FitExampleTemplate_2D"
  CmeLabel: "13 TeV"
  ImageFormat: png
  LumiLabel: "139 fb^{-1}"
  ReadFrom: HIST
  POI: "topWidth"
  HistoPath: "root://eosuser.cern.ch//eos/project/t/trexfitter-docs/test_inputs/Template"
  DebugLevel: 2
  LoggingFormat: NONE
  SystControlPlots: TRUE
  MCstatThreshold: 0.03
  StatOnly: FALSE
  RatioYmax: 1.2
  RatioYmin: 0.8
  RankingMaxNP: 15
  CorrelationThreshold: 0.01
  SmoothingOption: TTBARRESONANCE
  DoSummaryPlot: TRUE
  DoPieChartPlot: FALSE
  SystDataPlots: TRUE
  GetChi2: STAT+SYST
  PlotOptions: CHI2
  RankingPOIName: "#Gamma_{t}"
  SystPruningShape: 0.0001
  SystPruningNorm: 0.001
  StatOnly: TRUE

Fit: "FitTemplate"
  FitType: SPLUSB
  FitRegion: CRSR
  NumCPU: 1
  UseMinos: topWidth,topMass

Morphing: morphing
  FitFunction: QUADRATIC
  ParamLimits: Signal_1p5_172p5@SR_emu@0:0:-10:10
  ParamStartValue: Signal_1p5_172p5@SR_emu@0:0:1,Signal_1p5_172p5@SR_emu@1:0:2

Region: "SR_emu"
  Label: "emu"
  Type: SIGNAL
  HistoName: "nominal/reco_mlb150"
  VariableTitle: "reco m_{lb} [GeV]"

Sample: "Signal_0p7_170"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_0p7/reco_mlb150_mt170"
  Template: Signal_1p5_172p5@topWidth:0.7,topMass:170
  Regions: SR_emu

Sample: "Signal_0p7_172p5"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_0p7/reco_mlb150"
  Template: Signal_1p5_172p5@topWidth:0.7,topMass:172.5
  Regions: SR_emu

Sample: "Signal_0p7_175"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_0p7/reco_mlb150_mt175"
  Template: Signal_1p5_172p5@topWidth:0.7,topMass:175
  Regions: SR_emu

Sample: "Signal_1p0_170"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_1p0/reco_mlb150_mt170"
  Template: Signal_1p5_172p5@topWidth:1.0,topMass:170
  Regions: SR_emu

Sample: "Signal_1p0_172p5"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_1p0/reco_mlb150"
  Template: Signal_1p5_172p5@topWidth:1.0,topMass:172.5
  Regions: SR_emu

Sample: "Signal_1p0_175"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_1p0/reco_mlb150_mt175"
  Template: Signal_1p5_172p5@topWidth:1.0,topMass:175
  Regions: SR_emu

Sample: "Signal_2p0_170"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_2p0/reco_mlb150_mt170"
  Template: Signal_1p5_172p5@topWidth:2.0,topMass:170
  Regions: SR_emu

Sample: "Signal_2p0_172p5"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_2p0/reco_mlb150"
  Template: Signal_1p5_172p5@topWidth:2.0,topMass:172.5
  Regions: SR_emu

Sample: "Signal_2p0_175"
  Type: GHOST
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_2p0/reco_mlb150_mt175"
  Template: Signal_1p5_172p5@topWidth:2.0,topMass:175
  Regions: SR_emu

Sample: "PseudoData"
  Type: data
  Title: "PseudoData"
  HistoFile: "Pseudodata"
  HistoName: "reco_mlb150"
  Regions: SR_emu

Sample: "Bkg_SR"
  Type: BACKGROUND
  Title: "Bkg"
  FillColor: 619
  LineColor: 619
  SeparateGammas: TRUE
  HistoFile: "Bkg"
  Regions: SR_emu

Sample: "Signal_1p5_172p5"
  Type: SIGNAL
  Title: "t#bar{t}"
  FillColor: 0
  LineColor: 1
  HistoFile: "ttbar"
  HistoName: "nominal/width_1p5/reco_mlb150"
  Template: topWidth:1.5,topMass:172.5
  Regions: SR_emu

NormFactor: "ttbarXsec"
  Title: "ttbarXsec"
  Nominal: 1
  Min: -10
  Max: 10
  Samples: Signal_1p5_172p5

Systematic: "bTagSF_B_0"
  Title: "bTagSF_B_0"
  NuisanceParameter: "bTagSF_B_0"
  Type: HISTO
  Samples: Signal_1p5_172p5
  HistoFileUp: "ttbar"
  HistoFileDown: "ttbar"
  HistoNameUp: "weight_bTagSF_MV2c10_60_eigenvars_B_up_0/reco_mlb150"
  HistoNameDown: "weight_bTagSF_MV2c10_60_eigenvars_B_down_0/reco_mlb150"
  Symmetrisation: TwoSided
  Category: Btag
  Regions: SR_emu

Systematic: "CategoryReduction_JET_JER_EffectiveNP_2"
  Title: "JET_BJES_Response"
  NuisanceParameter: "JET_BJES_Response"
  Type: HISTO
  Samples: Signal_1p5_172p5
  HistoFileUp: "ttbar"
  HistoFileDown: "ttbar"
  HistoNameUp: "CategoryReduction_JET_JER_EffectiveNP_2__1up/reco_mlb150"
  HistoNameDown: "CategoryReduction_JET_JER_EffectiveNP_2__1down/reco_mlb150"
  Symmetrisation: TwoSided
  Category: Jet
  Smoothing: 40
  Regions: SR_emu
