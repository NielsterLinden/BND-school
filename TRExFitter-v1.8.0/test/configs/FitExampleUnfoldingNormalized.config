  MigrationNameDown: "bTagSF_B_eigen0_1down/leadingTop_pt_migration"
  MigrationNameUp: "bTagSF_B_eigen0_1up/leadingTop_pt_migration"
  Category: Btag

UnfoldingSystematic: "PS"
  Title: "PS"
  Type: HISTO
  Samples: "SignalSample1"
