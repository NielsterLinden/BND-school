# CH (this z-tautau checkout) comes from condor/orchestrator.sh:
#   condor_submit CH=<checkout>/z-tautau condor/rank.sub
executable = $(CH)/condor/run_rank.sh
arguments  = $(CH) $(np)

output = $(CH)/condor/out/rank_$(np)_$(Cluster).$(Process).log
error  = $(CH)/condor/err/rank_$(np)_$(Cluster).$(Process).log
log    = $(CH)/condor/logs/rank_$(Cluster).log

stream_output = True
stream_error  = True

accounting_group = atlas

request_cpus   = 1
request_memory = 4GB

+JobCategory = "short"
+SingularityImage    = "/cvmfs/atlas.cern.ch/repo/containers/fs/singularity/x86_64-almalinux9"
+SingularityBindCVMFS = True

JobBatchName = "ztt_rank"

queue np from $(CH)/condor/params_rank.txt
