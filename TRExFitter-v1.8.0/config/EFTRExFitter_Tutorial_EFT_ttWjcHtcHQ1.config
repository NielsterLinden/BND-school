% -------------------- %
% --- NORM FACTORS --- %
% -------------------- %

NormFactor: "cHt"
  Title: "c_{Ht}"
  Category: EFT
  Exclude: *
  Nominal: 0.0
  Min: -100.0
  Max: 100.0

NormFactor: "cHQ1"
  Title: "c_{HQ}^{1}"
  Category: EFT
  Exclude: *
  Nominal: 0.0
  Min: -100.0
  Max: 100.0

NormFactor: "norm_ttZ"
  Samples: ttZ
  Title: "N_{t#bar{t}Z}"
  Nominal: 1.0
  Min: -10.0
  Max: 10.0

NormFactor: "norm_ttW_QCD"
  Samples: ttW_QCD
  Title: "N_{t#bar{t}W QCD}"
  Nominal: 1.0
  Min: -10.0
  Max: 10.0

NormFactor: "norm_diboson"
  Samples: diboson
  Title: "N_{VV}"
  Nominal: 1.0
  Min: -10.0
  Max: 10.0

