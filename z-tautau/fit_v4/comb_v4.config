% v4 combination of the four Z -> tautau channels as a TRExFitter v1.8.0 MultiFit over the per-channel
% workspaces (fitting/CONVENTIONS.md section 5). Each channel job reads its own exported fit inputs
% (fit_v4/fitinputs/ztautau_v4_<channel>.root, scripts/step4b_export_channels_v4.py) with the tau_h ID
% scale factors free; shared nuisance-parameter names (TauIDSF_DM*, TauES_DM*, Lumi, Pileup, ...) are
% correlated by name, so this MultiFit is the same model as the single-file fit of step 5. Run from fit_v4/:
%     trex-fitter mwf comb_v4.config      trex-fitter mdp comb_v4.config
%     trex-fitter mr  comb_v4.config      trex-fitter mi  comb_v4.config
% To add the other groups' channels (after they adopt the conventions) append Fit blocks pointing at
% ../../z-mumu/fit/zmumu.config etc.; z-mumu's tt control region mumu_CRemu shares events with emu_SR and
% must be dropped there (docs/10-v4-plan.md section 4).
MultiFit: "comb_v4"
  Label: "Z #rightarrow #tau#tau, four channels"
  OutputDir: "results"
  Combine: TRUE
  Compare: TRUE
  ComparePOI: TRUE
  ComparePulls: TRUE
  PlotCombCorrMatrix: TRUE
  POIName: "mu_Z"
  POIRange: 0.8:1.3
  DataName: "obsData"
  CmeLabel: "13 TeV"
  LumiLabel: "16.4 fb^{-1}"
  NumCPU: 6

Fit: "ztautau_v4_tautau"
  ConfigFile: ztautau_v4_tautau.config
  Directory: results/ztautau_v4_tautau
  Label: "#tau_{h}#tau_{h}"

Fit: "ztautau_v4_mutau"
  ConfigFile: ztautau_v4_mutau.config
  Directory: results/ztautau_v4_mutau
  Label: "#mu#tau_{h}"

Fit: "ztautau_v4_etau"
  ConfigFile: ztautau_v4_etau.config
  Directory: results/ztautau_v4_etau
  Label: "e#tau_{h}"

Fit: "ztautau_v4_emu"
  ConfigFile: ztautau_v4_emu.config
  Directory: results/ztautau_v4_emu
  Label: "e#mu"
