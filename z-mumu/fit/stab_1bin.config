% Z -> mumu cross section, CMS Open Data 2016 G+H, TRExFitter v1.8.0
% generated by scripts/v2_5_fit.py -- run from z-mumu/fit/:  trex-fitter <actions> zmumu.config

Job: "stab_1bin"
  ExperimentLabel: "CMS Open Data"
  Label: "Z #rightarrow #mu#mu"
  CmeLabel: "13 TeV"
  LumiLabel: "16.4 fb^{-1}"
  POI: "mu_Z"
  ReadFrom: HIST
  HistoPath: "fitinputs"
  HistoFile: "stab_1bin"
  OutputDir: "results"
  MCstatThreshold: 0
  UseGammaPulls: TRUE
  SystControlPlots: TRUE
  SystCategoryTables: TRUE
  SystLarge: 0.5
  SuppressNegativeBinWarnings: TRUE
  GetChi2: TRUE
  DoSummaryPlot: TRUE
  DoTables: TRUE
  RankingMaxNP: 25
  RankingPlot: ALL
  ImageFormat: "png"
  PlotOptions: "YIELDS"
  RatioYmin: 0.95
  RatioYmax: 1.05
  RatioYminPostFit: 0.98
  RatioYmaxPostFit: 1.02
  DebugLevel: 1

Fit: "fit"
  FitType: SPLUSB
  FitRegion: CRSR
  UseMinos: "all"
  NumCPU: 4

Region: "mumu_SR"
  Type: SIGNAL
  HistoName: "mumu_SR"
  VariableTitle: "m_{#mu#mu} [GeV]"
  Label: "#mu#mu, 60 < m < 120 GeV"
  ShortLabel: "SR"
  BinWidth: 60
  LogScale: TRUE

Region: "mumu_CRemu"
  Type: VALIDATION
  HistoName: "mumu_CRemu"
  VariableTitle: "m_{e#mu} [GeV]"
  Label: "e#mu (OS)"
  ShortLabel: "CR e#mu"
  BinWidth: 5

Sample: "Data"
  Type: DATA
  Title: "Data"
  HistoNameSuff: "__Data"

Sample: "DYmumu"
  Type: SIGNAL
  Title: "Z/#gamma* #rightarrow #mu#mu"
  FillColor: 800
  LineColor: 1
  HistoNameSuff: "__DYmumu"
  Regions: mumu_SR,mumu_CRemu

Sample: "DYtautau"
  Type: BACKGROUND
  Title: "Z/#gamma* #rightarrow #tau#tau"
  FillColor: 616
  LineColor: 1
  HistoNameSuff: "__DYtautau"
  Regions: mumu_SR,mumu_CRemu

Sample: "TTbar"
  Type: BACKGROUND
  Title: "t#bar{t}"
  FillColor: 632
  LineColor: 1
  HistoNameSuff: "__TTbar"
