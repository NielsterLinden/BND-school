% Z -> tautau v4 (four channels), generated by z-tautau/scripts/step5_fit.py (do not edit by hand); tau_h working point Tight
% tau_h ID scale factors free per decay mode (nominal = TauPOG), tau energy scale prior 3%; TRExFitter v1.8.0

Job: "ztautau_emu_fixedid"
  Label: "Z #rightarrow #tau#tau (#tau_{h}#tau_{h}, #mu#tau_{h}, e#tau_{h}, e#mu)"
  CmeLabel: "13 TeV"
  LumiLabel: "16.4 fb^{-1}"
  ExperimentLabel: "CMS"
  PlotLabel: "Open Data"
  POI: "mu_Z"
  ReadFrom: HIST
  HistoPath: "fitinputs"
  HistoFile: "ztautau_emu"
  OutputDir: "results"
  MCstatThreshold: 0.0
  UseGammaPulls: TRUE
  DebugLevel: 1
  ImageFormat: "png"
  SystControlPlots: FALSE
  DoSummaryPlot: TRUE
  DoTables: TRUE
  DoSignalRegionsPlot: FALSE
  DoPieChartPlot: TRUE
  RankingMaxNP: 25
  RankingPlot: SYSTS
  HistoChecks: NOCRASH
  SystPruningShape: 0.001
  SystPruningNorm: 0.001
  GetChi2: TRUE
  SystCategoryTables: TRUE
  RatioYmax: 1.5
  RatioYmin: 0.5
  POIPrecision: 3
  SummaryPlotYmin: 1
  LegendNColumns: 2
  PlotOptions: NOSIG,NOXERR
  SummaryPlotRegions: emu_SR,emu_CRtt

Fit: "fit"
  FitType: SPLUSB
  FitRegion: CRSR
  UseMinos: "mu_Z"
  NumCPU: 4

Region: "emu_SR"
  Type: SIGNAL
  HistoName: "emu_SR"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "e#mu"
  ShortLabel: "emu_SR"

Region: "emu_CRtt"
  Type: CONTROL
  HistoName: "emu_CRtt"
  VariableTitle: "m_{#tau#tau} [GeV]"
  Label: "e#mu t#bar{t} CR"
  ShortLabel: "emu_CRtt"

Sample: "Data"
  Type: DATA
  Title: "Data"
  HistoNameSuff: "__Data"

Sample: "DYtautau_tDMnone"
  Type: SIGNAL
  Title: "Z/#gamma*#rightarrow#tau#tau (60-120) [none]"
  Group: "Z/#gamma*#rightarrow#tau#tau (60-120)"
  HistoNameSuff: "__DYtautau_tDMnone"
  FillColor: 796
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "DYee_tDMnone"
  Type: BACKGROUND
  Title: "Z#rightarrowee [none]"
  Group: "Z#rightarrowee"
  HistoNameSuff: "__DYee_tDMnone"
  FillColor: 857
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "DYlowmass_tDMnone"
  Type: BACKGROUND
  Title: "Z/#gamma*#rightarrowll (m<50) [none]"
  Group: "Z/#gamma*#rightarrowll (m<50)"
  HistoNameSuff: "__DYlowmass_tDMnone"
  FillColor: 795
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "DYmumu_tDMnone"
  Type: BACKGROUND
  Title: "Z#rightarrow#mu#mu [none]"
  Group: "Z#rightarrow#mu#mu"
  HistoNameSuff: "__DYmumu_tDMnone"
  FillColor: 862
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "DYtautau_out_tDMnone"
  Type: BACKGROUND
  Title: "Z/#gamma*#rightarrow#tau#tau (outside) [none]"
  Group: "Z/#gamma*#rightarrow#tau#tau (outside)"
  HistoNameSuff: "__DYtautau_out_tDMnone"
  FillColor: 800
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "SingleTop_tDMnone"
  Type: BACKGROUND
  Title: "single t [none]"
  Group: "single t"
  HistoNameSuff: "__SingleTop_tDMnone"
  FillColor: 617
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "TTbar_tDMnone"
  Type: BACKGROUND
  Title: "t#bar{t} [none]"
  Group: "t#bar{t}"
  HistoNameSuff: "__TTbar_tDMnone"
  FillColor: 616
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "WJets_tDMnone"
  Type: BACKGROUND
  Title: "W+jets [none]"
  Group: "W+jets"
  HistoNameSuff: "__WJets_tDMnone"
  FillColor: 632
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: FALSE

Sample: "WW_tDMnone"
  Type: BACKGROUND
  Title: "WW [none]"
  Group: "WW"
  HistoNameSuff: "__WW_tDMnone"
  FillColor: 418
  LineColor: 1
  Regions: emu_SR,emu_CRtt
  UseMCstat: TRUE

Sample: "WZ_tDMnone"
  Type: BACKGROUND
  Title: "WZ [none]"
  Group: "WZ"
  HistoNameSuff: "__WZ_tDMnone"
  FillColor: 419
  LineColor: 1
  Regions: emu_SR,emu_CRtt
