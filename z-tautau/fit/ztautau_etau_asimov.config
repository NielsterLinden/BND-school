NormFactor: "mu_Z"
  Title: "#mu_{Z}"
  Nominal: 1
  Min: 0
  Max: 3
  Samples: DYtautau_tDM0,DYtautau_tDM1,DYtautau_tDM10,DYtautau_tDM11,DYtautau_tDMnone

NormFactor: "mu_ttbar"
  Title: "#mu_{t#bar{t}}"
  Nominal: 1
  Min: 0
  Max: 3
  Samples: TTbar_tDM0,TTbar_tDM1,TTbar_tDM10,TTbar_tDM11,TTbar_tDMnone

NormFactor: "TauIDSF_DM0"
  Title: "#tau_{h} ID SF DM0"
  Nominal: 0.9016
  Min: 0.5
  Max: 1.5
  Samples: DYee_tDM0,DYtautau_out_tDM0,DYtautau_tDM0,SingleTop_tDM0,TTbar_tDM0,WJets_tDM0,WW_tDM0,WZ_tDM0,ZZ_tDM0
  Category: "Tau ID (fitted)"

NormFactor: "TauIDSF_DM1"
  Title: "#tau_{h} ID SF DM1"
  Nominal: 0.8919
  Min: 0.5
  Max: 1.5
  Samples: DYlowmass_tDM1,DYtautau_out_tDM1,DYtautau_tDM1,SingleTop_tDM1,TTbar_tDM1,WJets_tDM1,WW_tDM1,WZ_tDM1,ZZ_tDM1
